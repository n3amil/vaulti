{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaulti",
  "version": "0.1.0",
  "identifier": "dev.vaulti",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vaulti",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Peer-to-peer password manager",
    "longDescription": "Vaulti is a password manager without a central server. Devices sync directly; collections can be shared with other people.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
